  "product_data_rules": [
    "Retailer-supplied facts such as price, stock and images must remain distinct from FRONTERA suitability assessments.",
    "Products may be listed in the general catalog without verified environment or activity fit.",
    "Only fit_review_status=verified products may be recommended by the trip planner.",
    "Verification requires a review date, an HTTPS source, and evidence supporting every assigned environment, activity and condition.",
    "Do not infer temperature, waterproofness, wind rating, UV protection, vehicle compatibility, flotation or safety ratings from product titles, images or category.",
    "Use all-environments only when authoritative evidence supports the breadth of the claim.",
    "If a required specification is unavailable, leave that fit unverified and explain the limitation rather than guessing.",
    "Vehicle-mounted products require compatibility and installation constraints to be recorded before vehicle-specific recommendations."
  ],
  "fit_metadata_contract": {
    "fit_review_status": [
      "unreviewed",
      "needs-more-evidence",
      "verified",
      "not-suitable"
    ],
    "required_when_verified": [
      "fit_reviewed_at",
      "fit_review_source",
      "environment_fit",
      "activity_fit",
      "condition_fit"
    ],
    "fit_review_source": "HTTPS manufacturer specification, manual, or authoritative product documentation.",
    "environment_fit": "Array of exact planner_label strings from environments[].planner_label (e.g. Desert, Mountain / alpine, Forest / rainforest, River / lake) or all-environments. The planner compares these labels exactly.",
    "activity_fit": "Array of exact planner_label strings from activities[].planner_label (e.g. Hiking, Camping). The planner compares these labels exactly.",
    "condition_fit": "Array of exact planner condition strings used by the trip planner (e.g. hot, cold, rain, wind, snow, humid) or all-season. Confirm the current planner condition vocabulary before assigning values."
  }
