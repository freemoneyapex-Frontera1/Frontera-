{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freemoneyapex-frontera1.github.io/Frontera-/data/product.schema.json",
  "title": "FRONTERA Product Catalog",
  "type": "object",
  "required": [
    "updated_at",
    "products"
  ],
  "properties": {
    "updated_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "brand",
          "description",
          "category",
          "url"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "brand": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "enum": [
              "shelter",
              "sleep",
              "cook",
              "trail",
              "light",
              "water",
              "food",
              "offroad",
              "marine",
              "vehicles",
              "apparel",
              "other"
            ]
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "price": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "image": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          },
          "availability": {
            "type": "string"
          },
          "updated_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "features": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "activities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "terrain": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "climate": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "featured": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
