{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freemoneyapex-frontera1.github.io/Frontera-/data/product.schema.json",
  "title": "FRONTERA Product Catalog",
  "type": "object",
  "required": [
    "updated_at",
    "products"
  ],
  "properties": {
    "updated_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "brand",
          "description",
          "category",
          "url"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "brand": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "enum": [
              "shelter",
              "sleep",
              "apparel",
              "footwear",
              "cook",
              "water",
              "trail",
              "light",
              "power",
              "navigation",
              "safety",
              "offroad",
              "vehicles",
              "storage",
              "marine",
              "fishing",
              "food",
              "other"
            ]
          },
          "subcategory": {
            "type": [
              "string",
              "null"
            ]
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "price": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "image": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          },
          "availability": {
            "type": "string"
          },
          "updated_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "features": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "activities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "terrain": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "climate": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "featured": {
            "type": "boolean"
          },
          "supplier": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_feed": {
            "type": [
              "string",
              "null"
            ]
          },
          "fit_review_status": {
            "type": "string",
            "enum": [
              "unreviewed",
              "needs-more-evidence",
              "verified",
              "not-suitable"
            ]
          },
          "fit_reviewed_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "fit_review_source": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri",
            "pattern": "^https://"
          },
          "environment_fit": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "activity_fit": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "condition_fit": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "fit_notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "manufacturer_specs": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "boolean",
                "null"
              ]
            }
          },
          "comparison_assessment": {
            "type": "object",
            "description": "Source-backed FRONTERA assessment used for transparent comparison recommendations. Do not populate without a documented review.",
            "required": [
              "value_score",
              "quality_tier",
              "summary",
              "reviewed_at",
              "source"
            ],
            "properties": {
              "value_score": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "quality_tier": {
                "type": "string",
                "enum": [
                  "basic",
                  "standard",
                  "premium",
                  "professional"
                ]
              },
              "summary": {
                "type": "string",
                "minLength": 1
              },
              "strengths": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "tradeoffs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "reviewed_at": {
                "type": "string",
                "format": "date"
              },
              "source": {
                "type": "string",
                "format": "uri",
                "pattern": "^https://"
              }
            },
            "additionalProperties": false
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "fit_review_status": {
                  "const": "verified"
                }
              },
              "required": [
                "fit_review_status"
              ]
            },
            "then": {
              "required": [
                "fit_reviewed_at",
                "fit_review_source",
                "environment_fit",
                "activity_fit",
                "condition_fit"
              ]
            }
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
